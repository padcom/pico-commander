// Small helpers the modules share.

export function imin(a: int, b: int): int {
  return if (a < b) a else b
}

export function imax(a: int, b: int): int {
  return if (a > b) a else b
}

/// Compares strings for `sort`.
export function compareStrings(a: string, b: string): int {
  return if (a < b) -1 else if (a > b) 1 else 0
}
