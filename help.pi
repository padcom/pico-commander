// Help: how commander lays out a command's help. Its methods are virtual, so a subclass can
// change a part (`Command.configureHelp` sets the simple settings).

import { wrap } from "std/fmt"
import { displayWidth as columns, stripAnsi } from "std/term"
import { Argument, humanReadableArgName } from "./argument"
import { Command } from "./command"
import { Option } from "./option"
import { Value } from "./value"

/// The settings `Command.configureHelp` takes.
export struct HelpConfiguration {
  /// The width help wraps to (default: the output's, 80).
  helpWidth?: int
  sortSubcommands?: bool
  sortOptions?: bool
  /// Also lists the options of the parent commands, under "Global Options:".
  showGlobalOptions?: bool
  /// Styling (commander 14): what each part of the help looks like, such as
  /// `styleTitle: (str) => `\x1b[1m${str}\x1b[22m``. Colours are removed when the output
  /// has none (see `OutputConfiguration.getOutHasColors`).
  styleTitle?: (str: string) => string
  styleUsage?: (str: string) => string
  styleCommandText?: (str: string) => string
  styleCommandDescription?: (str: string) => string
  styleDescriptionText?: (str: string) => string
  styleOptionTerm?: (str: string) => string
  styleSubcommandTerm?: (str: string) => string
  styleArgumentTerm?: (str: string) => string
  styleOptionText?: (str: string) => string
  styleArgumentText?: (str: string) => string
  styleSubcommandText?: (str: string) => string
  styleOptionDescription?: (str: string) => string
  styleSubcommandDescription?: (str: string) => string
  styleArgumentDescription?: (str: string) => string
}

/// What `prepareContext` is told before the help is laid out (commander 14's context options).
export struct HelpContextOptions {
  error?: bool
  helpWidth?: int
  outputHasColors?: bool
}

export class Help {
  public helpWidth: int? = null
  public sortSubcommands: bool = false
  public sortOptions: bool = false
  public showGlobalOptions: bool = false
  /// Descriptions narrower than this aren't wrapped.
  public minWidthToWrap: int = 40
  private config: HelpConfiguration? = null

  constructor(config: HelpConfiguration? = null) {
    this.config = config
    if (config != null) {
      this.helpWidth = config.helpWidth
      this.sortSubcommands = config.sortSubcommands ?? false
      this.sortOptions = config.sortOptions ?? false
      this.showGlobalOptions = config.showGlobalOptions ?? false
    }
  }

  // ---- styling (commander 14): each returns `str` unless configured or overridden

  private styled(f: ((str: string) => string)?, str: string): string {
    return if (f != null) f(str) else str
  }

  public virtual styleTitle(str: string): string {
    return styled(config?.styleTitle, str)
  }

  /// The usage line, word by word: `[options]`, `[command]`, arguments, the command's words.
  public virtual styleUsage(str: string): string {
    const f = config?.styleUsage
    if (f != null) return f(str)
    return str.split(" ").map((word: string) => {
      if (word == "[options]") return styleOptionText(word)
      if (word == "[command]") return styleSubcommandText(word)
      if (word.startsWith("[") || word.startsWith("<")) return styleArgumentText(word)
      return styleCommandText(word)
    }).join(" ")
  }

  public virtual styleCommandDescription(str: string): string {
    const f = config?.styleCommandDescription
    return if (f != null) f(str) else styleDescriptionText(str)
  }

  public virtual styleOptionDescription(str: string): string {
    const f = config?.styleOptionDescription
    return if (f != null) f(str) else styleDescriptionText(str)
  }

  public virtual styleSubcommandDescription(str: string): string {
    const f = config?.styleSubcommandDescription
    return if (f != null) f(str) else styleDescriptionText(str)
  }

  public virtual styleArgumentDescription(str: string): string {
    const f = config?.styleArgumentDescription
    return if (f != null) f(str) else styleDescriptionText(str)
  }

  public virtual styleDescriptionText(str: string): string {
    return styled(config?.styleDescriptionText, str)
  }

  public virtual styleOptionTerm(str: string): string {
    const f = config?.styleOptionTerm
    return if (f != null) f(str) else styleOptionText(str)
  }

  /// A subcommand's term, word by word: `[options]`, arguments, the subcommand's words.
  public virtual styleSubcommandTerm(str: string): string {
    const f = config?.styleSubcommandTerm
    if (f != null) return f(str)
    return str.split(" ").map((word: string) => {
      if (word == "[options]") return styleOptionText(word)
      if (word.startsWith("[") || word.startsWith("<")) return styleArgumentText(word)
      return styleSubcommandText(word)
    }).join(" ")
  }

  public virtual styleArgumentTerm(str: string): string {
    const f = config?.styleArgumentTerm
    return if (f != null) f(str) else styleArgumentText(str)
  }

  public virtual styleOptionText(str: string): string {
    return styled(config?.styleOptionText, str)
  }

  public virtual styleArgumentText(str: string): string {
    return styled(config?.styleArgumentText, str)
  }

  public virtual styleSubcommandText(str: string): string {
    return styled(config?.styleSubcommandText, str)
  }

  public virtual styleCommandText(str: string): string {
    return styled(config?.styleCommandText, str)
  }

  /// How wide `str` shows: the terminal columns it takes (colour codes take none, wide
  /// characters two).
  public virtual displayWidth(str: string): int {
    return columns(str)
  }

  /// The items in groups (commander 14's `groupItems`): the groups in the order they first
  /// appear in `all` (the command's own, hidden ones too), then in `visible`; each with its
  /// visible items in order. Not virtual: pico's generic methods can't be (E0358).
  public groupItems<T>(all: T[], visible: T[], groupOf: (item: T) => string): [string, T[]][] {
    const out: [string, T[]][] = []
    const find = (g: string): int => {
      for (let i = 0; i < out.length; i++) {
        if (out[i][0] == g) return i
      }
      out.push([g, []])
      return out.length - 1
    }
    for (const item of all) find(groupOf(item))
    for (const item of visible) out[find(groupOf(item))][1].push(item)
    return out
  }

  /// The subcommands help lists, with the help command.
  public virtual visibleCommands(cmd: Command): Command[] {
    const out = cmd.commands.filter((c: Command) => !c.isHidden())
    const helpCommand = cmd.getHelpCommand()
    if (helpCommand != null && !helpCommand.isHidden()) out.push(helpCommand)
    if (sortSubcommands) out.sort((a: Command, b: Command) => a.name().localeCompare(b.name()))
    return out
  }

  /// Orders options by their short flag, else their long one (without dashes).
  public virtual compareOptions(a: Option, b: Option): int {
    return sortKey(a).localeCompare(sortKey(b))
  }

  /// The options help lists, with the help option unless another option took its flags.
  public virtual visibleOptions(cmd: Command): Option[] {
    const out = cmd.options.filter((o: Option) => !o.hidden)
    const helpOption = cmd.getHelpOption()
    if (helpOption != null && !helpOption.hidden) {
      const hs = helpOption.short
      const hl = helpOption.long
      const removeShort = hs != null && cmd.findOption(hs) != null
      const removeLong = hl != null && cmd.findOption(hl) != null
      if (!removeShort && !removeLong) {
        out.push(helpOption)
      } else if (hl != null && !removeLong) {
        out.push(new Option(hl, helpOption.description))
      } else if (hs != null && !removeShort) {
        out.push(new Option(hs, helpOption.description))
      }
    }
    if (sortOptions) out.sort((a: Option, b: Option) => compareOptions(a, b))
    return out
  }

  /// The options of the parent commands, when `showGlobalOptions` is on.
  public virtual visibleGlobalOptions(cmd: Command): Option[] {
    const out: Option[] = []
    if (!showGlobalOptions) return out
    let ancestor = cmd.parent
    while (ancestor != null) {
      for (const o of ancestor.options) {
        if (!o.hidden) out.push(o)
      }
      ancestor = ancestor.parent
    }
    if (sortOptions) out.sort((a: Option, b: Option) => compareOptions(a, b))
    return out
  }

  /// The arguments help lists: all of them when one has a description, else none.
  public virtual visibleArguments(cmd: Command): Argument[] {
    for (const a of cmd.registeredArguments) {
      if (a.description != "") return cmd.registeredArguments
    }
    return []
  }

  /// `name|alias [options] <args>`, as the list of subcommands shows a command.
  public virtual subcommandTerm(cmd: Command): string {
    const args = cmd.registeredArguments.map((a: Argument) => humanReadableArgName(a)).join(" ")
    const aliases = cmd.aliases()
    return cmd.name() + (if (aliases.length > 0) "|" + aliases[0] else "") +
      (if (cmd.options.length > 0) " [options]" else "") + (if (args != "") " " + args else "")
  }

  public virtual optionTerm(option: Option): string {
    return option.flags
  }

  public virtual argumentTerm(argument: Argument): string {
    return argument.name()
  }

  public virtual longestSubcommandTermLength(cmd: Command): int {
    let n = 0
    for (const c of visibleCommands(cmd)) n = Math.max(n, displayWidth(styleSubcommandTerm(subcommandTerm(c))))
    return n
  }

  public virtual longestOptionTermLength(cmd: Command): int {
    let n = 0
    for (const o of visibleOptions(cmd)) n = Math.max(n, displayWidth(styleOptionTerm(optionTerm(o))))
    return n
  }

  public virtual longestGlobalOptionTermLength(cmd: Command): int {
    let n = 0
    for (const o of visibleGlobalOptions(cmd)) n = Math.max(n, displayWidth(styleOptionTerm(optionTerm(o))))
    return n
  }

  public virtual longestArgumentTermLength(cmd: Command): int {
    let n = 0
    for (const a of visibleArguments(cmd)) n = Math.max(n, displayWidth(styleArgumentTerm(argumentTerm(a))))
    return n
  }

  /// `parent sub|alias [options] <args>`: the "Usage:" line.
  public virtual commandUsage(cmd: Command): string {
    let cmdName = cmd.name()
    const aliases = cmd.aliases()
    if (aliases.length > 0) cmdName += "|" + aliases[0]
    let ancestorNames = ""
    let ancestor = cmd.parent
    while (ancestor != null) {
      ancestorNames = ancestor.name() + " " + ancestorNames
      ancestor = ancestor.parent
    }
    return ancestorNames + cmdName + " " + cmd.usage()
  }

  public virtual commandDescription(cmd: Command): string {
    return cmd.description()
  }

  /// What the list of subcommands says of one: its summary, else its description.
  public virtual subcommandDescription(cmd: Command): string {
    const s = cmd.summary()
    return if (s != "") s else cmd.description()
  }

  /// The option's description with its choices, default, preset and environment variable.
  public virtual optionDescription(option: Option): string {
    const extra: string[] = []
    const choices = option.argChoices
    if (choices != null) extra.push(`choices: ${choices.map((c: string) => JSON.stringify(c)).join(", ")}`)
    const def = option.defaultValue
    if (def != null) {
      const showDefault = option.required || option.optional || (option.isBoolean() && def is Value.Bool(_))
      if (showDefault) extra.push(`default: ${option.defaultValueDescription ?? def.json()}`)
    }
    const preset = option.presetArg
    if (preset != null && option.optional) extra.push(`preset: ${preset.json()}`)
    const envVar = option.envVar
    if (envVar != null) extra.push(`env: ${envVar}`)
    if (extra.length > 0) return `${option.description} (${extra.join(", ")})`
    return option.description
  }

  /// The argument's description with its choices and default.
  public virtual argumentDescription(argument: Argument): string {
    const extra: string[] = []
    const choices = argument.argChoices
    if (choices != null) extra.push(`choices: ${choices.map((c: string) => JSON.stringify(c)).join(", ")}`)
    const def = argument.defaultValue
    if (def != null) extra.push(`default: ${argument.defaultValueDescription ?? def.json()}`)
    if (extra.length > 0) {
      const extraDescription = `(${extra.join(", ")})`
      if (argument.description != "") return `${argument.description} ${extraDescription}`
      return extraDescription
    }
    return argument.description
  }

  /// The width of the term column: the longest term of every list.
  public virtual padWidth(cmd: Command): int {
    return Math.max(longestOptionTermLength(cmd), longestGlobalOptionTermLength(cmd),
      longestSubcommandTermLength(cmd), longestArgumentTermLength(cmd))
  }

  /// Whether `str` is laid out already (a line break followed by a space or a tab): it isn't wrapped.
  public virtual preformatted(str: string): bool {
    return str.includes("\n ") || str.includes("\n\t")
  }

  /// `term`, padded to `termWidth`, and its description wrapped beside it; indented by 2.
  public virtual formatItem(term: string, termWidth: int, description: string): string {
    const itemIndent = "  "
    if (description == "") return itemIndent + term
    const spacerWidth = 2
    const remainingWidth = (helpWidth ?? 80) - termWidth - spacerWidth - 2
    let formatted = description
    if (remainingWidth >= minWidthToWrap && !preformatted(description)) {
      formatted = boxWrap(description, remainingWidth).replaceAll("\n", "\n" + " ".repeat(termWidth + spacerWidth))
    }
    // (Padded by how wide the term shows: colour codes take no room.)
    const padded = term + " ".repeat(Math.max(0, termWidth - displayWidth(term)))
    return itemIndent + padded + " ".repeat(spacerWidth) + formatted.replaceAll("\n", "\n" + itemIndent)
  }

  /// A heading, its items and an empty line; nothing without items.
  public virtual formatItemList(heading: string, items: string[]): string[] {
    if (items.length == 0) return []
    return [styleTitle(heading), ...items, ""]
  }

  /// Wraps `str` at spaces to `width` columns, keeping its line breaks; a width below
  /// `minWidthToWrap` leaves it as it is.
  public virtual boxWrap(str: string, width: int): string {
    if (width < minWidthToWrap) return str
    return wrap(str, width, (s: string) => displayWidth(s))
  }

  /// Called before `formatHelp` with the output's width and whether it has colours (and is
  /// stderr): commander uses the width, unless `helpWidth` is set; a subclass can keep more.
  public virtual prepareContext(contextOptions: HelpContextOptions): void {
    helpWidth = helpWidth ?? contextOptions.helpWidth ?? 80
  }

  /// `prepareContext` with `width`, then `formatHelp(cmd, this)` (0.2's form).
  public virtual formatHelp(cmd: Command, width: int): string {
    prepareContext({ helpWidth: width })
    return formatHelp(cmd, this)
  }

  /// The whole help of `cmd`, after `prepareContext`. (Commander lays it out with `helper`'s
  /// methods; this uses its own, so `helper` is `this` in practice.)
  public virtual formatHelp(cmd: Command, _helper: Help): string {
    const termWidth = padWidth(cmd)
    const item = (term: string, description: string): string => formatItem(term, termWidth, description)
    let output: string[] = [`${styleTitle("Usage:")} ${styleUsage(commandUsage(cmd))}`, ""]
    const description = commandDescription(cmd)
    if (description != "") {
      output.push(boxWrap(styleCommandDescription(description), helpWidth ?? 80))
      output.push("")
    }
    output = output.concat(formatItemList("Arguments:",
      visibleArguments(cmd).map((a: Argument) => item(styleArgumentTerm(argumentTerm(a)), styleArgumentDescription(argumentDescription(a))))))
    // Options and commands in their groups (commander 14's `helpGroup`), "Options:" and
    // "Commands:" by default.
    const optionGroups = groupItems(cmd.options, visibleOptions(cmd), (o: Option) => o.helpGroupHeading ?? "Options:")
    for (const [heading, opts] of optionGroups) {
      output = output.concat(formatItemList(heading,
        opts.map((o: Option) => item(styleOptionTerm(optionTerm(o)), styleOptionDescription(optionDescription(o))))))
    }
    if (showGlobalOptions) {
      output = output.concat(formatItemList("Global Options:",
        visibleGlobalOptions(cmd).map((o: Option) => item(styleOptionTerm(optionTerm(o)), styleOptionDescription(optionDescription(o))))))
    }
    const commandGroups = groupItems(cmd.commands, visibleCommands(cmd), (c: Command) => {
      const g = c.helpGroup()
      return if (g != "") g else "Commands:"
    })
    for (const [heading, cmds] of commandGroups) {
      output = output.concat(formatItemList(heading,
        cmds.map((c: Command) => item(styleSubcommandTerm(subcommandTerm(c)), styleSubcommandDescription(subcommandDescription(c))))))
    }
    return output.join("\n")
  }
}

/// `str` without ANSI colour codes, as commander's `stripColor` (`std/term`'s `stripAnsi`).
export function stripColor(str: string): string {
  return stripAnsi(str)
}

function sortKey(o: Option): string {
  const s = o.short
  if (s != null) return s.slice(1)
  return (o.long ?? "").slice(2)
}
