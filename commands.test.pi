// Arguments, subcommands, actions, hooks and the async parse.
import { describe, it, expect } from "std/test"
import { Argument, Command, CommanderError, Value, Values, parseInteger, parseNumber } from "./index"

class Probe {
  public out: string = ""
  public err: string = ""
  public log: string[] = []
  public program: Command = new Command("test")

  constructor() {
    program.exitOverride().configureOutput({
      writeOut: (s: string) => { out += s },
      writeErr: (s: string) => { err += s },
    })
  }

  public fails(argv: string[]): string {
    try {
      program.parse(argv)
    } catch (e: CommanderError) {
      return e.code
    } catch (e) {
      return `other: ${e.message}`
    }
    return ""
  }
}

describe("arguments", () => {
  it("required, optional and variadic", () => {
    const p = new Probe()
    let seen = ""
    p.program.argument("<src>").argument("[dest]").argument("[more...]")
      .action((args, _opts, _cmd) => { seen = `${args}` })
    p.program.parse(["a"])
    expect(seen).toBe("{ src: \"a\", dest: null, more: [] }")
    p.program.parse(["a", "b", "c", "d"])
    expect(seen).toBe("{ src: \"a\", dest: \"b\", more: [\"c\",\"d\"] }")
  })

  it("are read by name or position", () => {
    const p = new Probe()
    let args = new Values()
    p.program.arguments("<cmd> [env]").action((a, _opts, _cmd) => { args = a })
    p.program.parse(["build", "prod"])
    expect(args.string("cmd") ?? "").toBe("build")
    expect(args.get(1) is Value.Str("prod")).toBe(true)
    expect(args.length).toBe(2)
  })

  it("defaults, parsers and choices", () => {
    const p = new Probe()
    p.program.argument("[n]", "count", parseInteger, 1)
    p.program.addArgument(new Argument("[mode]").choices(["fast", "slow"]).default("fast"))
    p.program.parse([])
    expect(p.program.processedArgs.int("n") ?? 0).toBe(1)
    expect(p.program.processedArgs.string("mode") ?? "").toBe("fast")
    p.program.parse(["7", "slow"])
    expect(p.program.processedArgs.int("n") ?? 0).toBe(7)
    expect(p.fails(["7", "medium"])).toBe("commander.invalidArgument")
    expect(p.err).toBe("error: command-argument value 'medium' is invalid for argument 'mode'. Allowed choices are fast, slow.\n")
  })

  it("missing and excess", () => {
    const p = new Probe()
    p.program.argument("<file>")
    expect(p.fails([])).toBe("commander.missingArgument")
    expect(p.err).toBe("error: missing required argument 'file'\n")
    expect(p.fails(["a", "b"])).toBe("commander.excessArguments")
    expect(p.err.endsWith("error: too many arguments. Expected 1 argument but got 2.\n")).toBe(true)
  })

  it("only the last can be variadic", () => {
    const p = new Probe()
    p.program.argument("<files...>")
    expect(() => { p.program.argument("<other>") }).toPanic("only the last argument can be variadic")
  })
})

describe("subcommands", () => {
  it("dispatch by name and alias, with global options", () => {
    const p = new Probe()
    let seen = ""
    p.program.option("-g, --global")
    p.program.command("clone <source> [destination]").alias("cl")
      .option("--depth <n>")
      .action((args, opts, cmd) => {
        seen = `${cmd.name()} ${args} ${opts} ${cmd.optsWithGlobals()}`
      })
    p.program.parse(["cl", "repo", "--depth", "1", "-g"])
    expect(seen).toBe("clone { source: \"repo\", destination: null } { depth: \"1\" } { depth: \"1\", global: true }")
  })

  it("a default command runs without its name", () => {
    const p = new Probe()
    let ran = ""
    p.program.command("serve", { isDefault: true }).option("-p <port>").action((_a, opts, _c) => { ran = opts.string("p") ?? "" })
    p.program.command("build").action((_a, _o, _c) => { ran = "build" })
    p.program.parse(["-p", "80"])
    expect(ran).toBe("80")
    p.program.parse(["build"])
    expect(ran).toBe("build")
  })

  it("unknown commands fail, with a suggestion", () => {
    const p = new Probe()
    p.program.command("install").action((_a, _o, _c) => {})
    p.program.command("uninstall").action((_a, _o, _c) => {})
    expect(p.fails(["instal"])).toBe("commander.unknownCommand")
    expect(p.err).toBe("error: unknown command 'instal'\n(Did you mean install?)\n")
  })

  it("without a subcommand, help goes to stderr and the exit code is 1", () => {
    const p = new Probe()
    p.program.command("a").action((_a, _o, _c) => {})
    try {
      p.program.parse([])
    } catch (e: CommanderError) {
      expect(e.exitCode).toBe(1)
      expect(e.code).toBe("commander.help")
    }
    expect(p.err.startsWith("Usage: test [options] [command]")).toBe(true)
  })

  it("enablePositionalOptions keeps program options before the subcommand", () => {
    const p = new Probe()
    p.program.enablePositionalOptions().option("-v")
    let subV = false
    p.program.command("run").option("-v").action((_a, opts, _c) => { subV = opts.bool("v") })
    p.program.parse(["run", "-v"])
    expect(subV).toBe(true)
    expect(p.program.opts().has("v")).toBe(false)
  })

  it("passThroughOptions leaves options after the first operand alone", () => {
    const p = new Probe()
    let rest: string[] = []
    p.program.enablePositionalOptions()
    p.program.command("exec <cmd> [args...]").passThroughOptions().option("-d")
      .action((args, _o, _c) => { rest = args.strings("args") })
    p.program.parse(["exec", "ls", "-la", "-d"])
    expect(rest).toEqual(["-la", "-d"])
  })
})

describe("hooks", () => {
  it("run around the action, program hooks outermost", () => {
    const p = new Probe()
    p.program.hook("preAction", (t, a) => { p.log.push(`pre ${t.name()} ${a.name()}`) })
    p.program.hook("postAction", (t, a) => { p.log.push(`post ${t.name()} ${a.name()}`) })
    p.program.hook("preSubcommand", (_t, a) => { p.log.push(`sub ${a.name()}`) })
    const sub = p.program.command("go")
    sub.hook("preAction", (t, _a) => { p.log.push(`pre ${t.name()}`) })
    sub.action((_a, _o, _c) => { p.log.push("action") })
    p.program.parse(["go"])
    expect(p.log).toEqual(["sub go", "pre test go", "pre go", "action", "post test go"])
  })
})

async function slowAction(args: Values, _opts: Values, _cmd: Command): Promise<void> throws Error {
  await Promise.resolve(0)
  asyncLog.push(`async ${args.string("x") ?? ""}`)
}

async function slowHook(_t: Command, _a: Command): Promise<void> throws Error {
  await Promise.resolve(0)
  asyncLog.push("async hook")
}

const asyncLog: string[] = []

async function runsAsyncActions(): Promise<void> throws Error {
  const p = new Probe()
  p.program.argument("<x>").actionAsync(slowAction).hookAsync("preAction", slowHook)
  p.program.hook("postAction", (_t, _a) => { asyncLog.push("post") })
  await p.program.parseAsync(["hi"])
  expect(asyncLog).toEqual(["async hook", "async hi", "post"])
}

describe("parseAsync", () => {
  it("awaits async actions and hooks in order", runsAsyncActions)

  it("parse refuses an async action", () => {
    const p = new Probe()
    p.program.actionAsync(slowAction).argument("<x>")
    expect(() => { p.program.parse(["a"]) }).toPanic("parseAsync")
  })
})

describe("commander's overloaded methods", () => {
  it("name, description, summary, usage, alias and version read back", () => {
    const p = new Probe()
    p.program.name("tool").description("does things").summary("things").usage("[opts] <x>").version("1.2.3")
    const sub = p.program.command("run").alias("r").aliases(["go"])
    expect(p.program.name()).toBe("tool")
    expect(p.program.description()).toBe("does things")
    expect(p.program.summary()).toBe("things")
    expect(p.program.usage()).toBe("[opts] <x>")
    expect(p.program.version() ?? "").toBe("1.2.3")
    expect(sub.alias() ?? "").toBe("r")
    expect(sub.aliases()).toEqual(["r", "go"])
    expect(new Command().version() == null).toBe(true)
  })

  it("arguments and options take a parser before the default, as in commander", () => {
    const p = new Probe()
    p.program.argument("[n]", "count", parseInteger, 5).requiredOption("-p, --port <n>", "port", parseInteger, 80)
    p.program.parse([])
    expect(p.program.processedArgs.int(0) ?? 0).toBe(5)
    expect(p.program.opts().int("port") ?? 0).toBe(80)
    p.program.parse(["7", "-p", "8"])
    expect(p.program.processedArgs.int("n") ?? 0).toBe(7)
    expect(p.program.opts().int("port") ?? 0).toBe(8)
  })

  it("Values read by position too", () => {
    const p = new Probe()
    let args = new Values()
    p.program.argument("<a>").argument("[b...]").action((a, _o, _c) => { args = a })
    p.program.parse(["x", "y", "z"])
    expect(args.string(0) ?? "").toBe("x")
    expect(args.strings(1)).toEqual(["y", "z"])
    expect(args.has(2)).toBe(false)
  })

  it("{ hidden: true } leaves a command out of the help, helpCommand(false) the help command", () => {
    const p = new Probe()
    p.program.name("t").helpCommand(false)
    p.program.command("shown").action((_a, _o, _c) => {})
    p.program.command("secret", { hidden: true }).action((_a, _o, _c) => {})
    p.program.addCommand(new Command("extra"), { hidden: true })
    const help = p.program.helpInformation()
    expect(help).toContain("shown")
    expect(help.includes("secret") || help.includes("extra") || help.includes("help [command]")).toBe(false)
  })

  it("help({ error: true }) writes to stderr and exits with 1", () => {
    const p = new Probe()
    p.program.name("t")
    expect(p.fails(["--nope"])).toBe("commander.unknownOption")
    const q = new Probe()
    q.program.name("t").action((_a, _o, cmd) => { cmd.help({ error: true }) })
    expect(q.fails([])).toBe("commander.help")
    expect(q.err).toBe("Usage: t [options]\n\nOptions:\n  -h, --help  display help for command\n")
    expect(q.out).toBe("")
    q.program.outputHelp()
    expect(q.out).toBe(q.err)
  })

  it("showHelpAfterError() shows the whole help", () => {
    const p = new Probe()
    p.program.name("t").showHelpAfterError()
    expect(p.fails(["--nope"])).toBe("commander.unknownOption")
    expect(p.err).toBe("error: unknown option '--nope'\n\nUsage: t [options]\n\nOptions:\n  -h, --help  display help for command\n")
  })
})

const lambdaLog: string[] = []

async function asyncLambdas(): Promise<void> throws Error {
  const p = new Probe()
  p.program.argument("<x>")
    .hook("preAction", async (_t, _a) => {
      await Promise.resolve(0)
      lambdaLog.push("hook")
    })
    .action(async (args, _opts, _cmd) => {
      await Promise.resolve(0)
      lambdaLog.push(`action ${args.string("x") ?? ""}`)
    })
  await p.program.parseAsync(["go"])
  expect(lambdaLog).toEqual(["hook", "action go"])
}

describe("0.2", () => {
  it("action and hook take async lambdas, as in commander", asyncLambdas)

  it("a sync lambda still takes the sync action", () => {
    const p = new Probe()
    let ran = false
    p.program.action((_a, _o, _c) => { ran = true })
    p.program.parse([])
    expect(ran).toBe(true)
  })

  it("values have json() and text()", () => {
    expect(Value.List(["a", "b"]).json()).toBe("[\"a\",\"b\"]")
    expect(Value.List(["a", "b"]).text()).toBe("a,b")
    expect(Value.Str("x\"y").json()).toBe("\"x\\\"y\"")
    expect(Value.Int(3).text()).toBe("3")
  })

  it("addHelpText takes a function of the context", () => {
    const p = new Probe()
    p.program.name("t").addHelpText("after", (ctx) => `after ${ctx.command.name()} ${ctx.error}`)
      .addHelpText("before", (_ctx) => "")
    p.program.outputHelp()
    expect(p.out).toBe("Usage: t [options]\n\nOptions:\n  -h, --help  display help for command\nafter t false\n")
    p.program.outputHelp({ error: true })
    expect(p.err.endsWith("after t true\n")).toBe(true)
  })

  it("number parsers accept what number.parse does", () => {
    const p = new Probe()
    p.program.option("-x <x>", "", parseNumber).option("-n <n>", "", parseInteger)
    p.program.parse(["-x", ".5", "-n", "+7"])
    expect(p.program.opts().number("x") ?? 0.0).toBe(0.5)
    expect(p.program.opts().int("n") ?? 0).toBe(7)
  })
})
